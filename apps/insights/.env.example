# Select the one persistence adapter used by this Insights instance.
EVE_INSIGHTS_DATABASE=firestore

# Required when EVE_INSIGHTS_DATABASE=firestore.
FIREBASE_PROJECT_ID=eve-insights

# Local emulator only. Leave unset when using production ADC.
FIRESTORE_EMULATOR_HOST=localhost:8080

# Production deployments may use Application Default Credentials or:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Required when EVE_INSIGHTS_DATABASE=mysql.
# MYSQL_HOST=127.0.0.1
# MYSQL_USER=eve
# MYSQL_PASSWORD=
# MYSQL_DATABASE=eve_insights
# MYSQL_PORT=3306

# Required when EVE_INSIGHTS_DATABASE=postgres.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_USER=eve
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=eve_insights
# POSTGRES_PORT=5432

# Required when EVE_INSIGHTS_DATABASE=sqlite.
# Filesystem path, file: URL, or :memory:.
# SQLITE_PATH=../../databases/sqlite/data/eve_insights.db

# Required when EVE_INSIGHTS_DATABASE=supabase.
# Names match Vercel Marketplace. Local emulator: databases/supabase.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SECRET_KEY=
